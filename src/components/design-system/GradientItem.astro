---
interface Props {
  name: string;
  gradient: string; // CSS gradient or solid color
  value: string; // Code description
  usage?: string; // Usage note
  large?: boolean;
}

const { name, gradient, value, usage, large = false } = Astro.props;
---

<div class="gradient-item">
  <div class:list={["gradient-swatch", { "gradient-large": large }]} style={`background: ${gradient};`}></div>
  <div class="gradient-info">
    <span class="gradient-name">{name}</span>
    <code class="gradient-value">{value}</code>
    {usage && <span class="gradient-usage">{usage}</span>}
  </div>
</div>

<style>
  .gradient-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    background-color: var(--color-background);
    border: 1px solid var(--color-subtle);
    border-radius: 8px;
  }

  .gradient-swatch {
    height: 80px;
    border-radius: 6px;
    border: 1px solid var(--color-subtle);
  }

  .gradient-large {
    height: 120px;
  }

  .gradient-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .gradient-name {
    font-weight: 600;
    font-size: 14px;
    color: var(--color-default);
  }

  .gradient-value {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-tertiary);
    background-color: var(--color-surface);
    padding: 4px 6px;
    border-radius: 4px;
  }

  .gradient-usage {
    font-size: 12px;
    color: var(--color-muted);
    font-style: italic;
  }
</style>
