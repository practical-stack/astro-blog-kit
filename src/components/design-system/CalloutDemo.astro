---
interface Props {
  type: string; // e.g., "Note", "Tip", "Warning"
  colorName: string; // e.g., "Blue", "Sky", "Emerald"
  iconColor: string; // CSS variable
  titleColor: string; // CSS variable
}

const { type, colorName, iconColor, titleColor } = Astro.props;
---

<div class="callout-demo-item">
  <h4 class="callout-type-name">{type} ({colorName})</h4>
  <div class="callout-colors">
    <div class="callout-color-item">
      <div class="color-swatch" style={`background-color: ${iconColor};`}></div>
      <code>Icon: {iconColor.replace("var(", "").replace(")", "")}</code>
    </div>
    <div class="callout-color-item">
      <div class="color-swatch" style={`background-color: ${titleColor};`}></div>
      <code>Title: {titleColor.replace("var(", "").replace(")", "")}</code>
    </div>
  </div>
</div>

<style>
  .callout-demo-item {
    background-color: var(--color-background);
    border: 1px solid var(--color-subtle);
    border-radius: 8px;
    padding: 20px;
  }

  .callout-type-name {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 16px;
    color: var(--color-default);
  }

  .callout-colors {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .callout-color-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .callout-color-item .color-swatch {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border: 2px solid var(--color-subtle);
  }

  .callout-color-item code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-secondary);
    background-color: var(--color-surface);
    padding: 4px 8px;
    border-radius: 4px;
  }
</style>
