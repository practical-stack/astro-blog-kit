---
interface Props {
  name: string; // e.g., "--chakra-gray-50"
  value: string; // e.g., "#f7fafc"
  color: string; // CSS for background (can be var or hex)
  reference?: string; // e.g., "→ var(--color-white)"
}

const { name, value, color, reference } = Astro.props;
---

<div class="token-item">
  <div class="color-swatch" style={`background-color: ${color};`}></div>
  <div class="token-info">
    <div class="token-name">{name}</div>
    <div class="token-value">{value}</div>
    {reference && <div class="token-ref">{reference}</div>}
  </div>
</div>

<style>
  .token-item {
    display: flex;
    gap: 12px;
    padding: 16px;
    background-color: var(--color-background);
    border: 1px solid var(--color-subtle);
    border-radius: 8px;
    transition: all 0.2s;
  }

  .token-item:hover {
    border-color: var(--color-accent);
    box-shadow: 0 2px 8px rgba(66, 153, 225, 0.1);
  }

  .color-swatch {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    border: 2px solid var(--color-subtle);
    flex-shrink: 0;
  }

  .token-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .token-name {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-default);
  }

  .token-value {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-tertiary);
  }

  .token-ref {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-accent);
    font-style: italic;
  }
</style>
