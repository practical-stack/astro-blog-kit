---
import { format } from "date-fns";
import type { PostEntry } from "@/utils/posts/types";
import { getPostSlug } from "@/utils/posts/url";
import { stripLangFromId } from "@/utils/lang";
import { siteConfig } from "@/config/site";

interface Props {
  posts: PostEntry[];
  getHref?: (post: PostEntry) => string;
}

const { posts, getHref } = Astro.props;

// 기본 href 생성 함수 (모든 포스트는 /posts/{slug} 경로 사용)
const defaultGetHref = (post: PostEntry) => {
  if (post.collection === "seriesPosts") {
    return `/posts/${stripLangFromId(post.id)}`;
  }
  return `/posts/${getPostSlug(post)}`;
};
const resolveHref = getHref || defaultGetHref;

const spaceToDash = (text: string) => text.replace(/\s+/g, '-');

// 시리즈 포스트에서 시리즈 slug 추출
const getSeriesSlug = (post: PostEntry) => {
  if (post.collection === "seriesPosts") {
    return post.id.split("/")[0];
  }
  return null;
};

// 저자 (siteConfig에서 가져옴)
const author = `@${siteConfig.author.replace(/\s.*$/, "")}`;
---

<div>
  {posts.map((post ) => {
    const { title, description, date, tags = [] } = post.data;
    const formattedDate = format(date, "yyyy-MM-dd");
    const seriesSlug = getSeriesSlug(post);

    return (
      <div class="mb-12" data-post-id={post.id} data-collection={post.collection}>
        {seriesSlug && (
          <div class="mb-1.5">
            <a href={`/series/${seriesSlug}`} class="inline-flex items-center gap-1.5 px-2 py-0.5 text-xs font-medium text-tag-text bg-tag-bg rounded no-underline transition-colors duration-200 hover:bg-accent-bg hover:no-underline">
              <span>🗂️</span><span>{seriesSlug}</span>
            </a>
          </div>
        )}
        <a href={resolveHref(post)} class="link-title post-title">
          {seriesSlug && 'part' in post.data && post.data.part ? `${post.data.part}. ${title}` : title}
        </a>
        <p class="mt-1.5 mb-0">{description}</p>
        <span class="block text-xs text-muted mt-2.5 mb-3">{formattedDate} · {author}</span>
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <a href={`/tags/${tag}`} class="post-tag">
                <span class="post-tag-hash">#</span>{spaceToDash(tag)}
              </a>
            ))}
          </div>
        )}
      </div>
    );
  })}
</div>
